# Normaliza los finales de línea a LF en todo el repositorio.
# Evita que el workflow de GitHub Actions (Linux) y Windows generen diffs
# falsos en epg.xml por el cambio LF <-> CRLF.
* text=auto eol=lf

# Archivos binarios (no normalizar)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
